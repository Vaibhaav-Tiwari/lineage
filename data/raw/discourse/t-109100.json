_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":5975,"username":"NeilGirdhar","name":"Neil Girdhar","avatar_template":"/user_avatar/discuss.python.org/neilgirdhar/{size}/5776_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":3524,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/3","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301957,"name":"Neil Girdhar","username":"NeilGirdhar","avatar_template":"/user_avatar/discuss.python.org/neilgirdhar/{size}/5776_2.png","created_at":"2026-09-18T01:21:56.249Z","cooked":"\u003cp\u003eI just mean instead of \u003ccode\u003e.author\u003c/code\u003e as syntax.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T01:28:04.029Z","reply_count":1,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":4,"reads":241,"readers_count":240,"score":72.4,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Neil Girdhar","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":3524,"username":"cdce8p","name":"Marc Mueller","avatar_template":"/user_avatar/discuss.python.org/cdce8p/{size}/3575_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":5975,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301958,"name":"Marc Mueller","username":"cdce8p","avatar_template":"/user_avatar/discuss.python.org/cdce8p/{size}/3575_2.png","created_at":"2026-09-18T01:27:22.006Z","cooked":"\u003cp\u003eI don’t think that will work. The match statement mini-syntax doesn’t support \u003ccode\u003e[ ]\u003c/code\u003e. Even \u003ccode\u003e( )\u003c/code\u003e isn’t recognized as a function call but an \u003ccode\u003eisinstance\u003c/code\u003e check instead. So we’d first have to define what \u003ccode\u003e[ ]\u003c/code\u003e means for pattern matching.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T01:28:04.023Z","reply_count":0,"reply_to_post_number":4,"quote_count":0,"incoming_link_count":1,"reads":242,"readers_count":241,"score":82.6,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Marc Mueller","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":5975,"username":"NeilGirdhar","name":"Neil Girdhar","avatar_template":"/user_avatar/discuss.python.org/neilgirdhar/{size}/5776_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":3524,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/5","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301961,"name":"Moncef Slimani","username":"Mushrimpy","avatar_template":"/user_avatar/discuss.python.org/mushrimpy/{size}/37444_2.png","created_at":"2026-09-18T02:31:18.638Z","cooked":"\u003cp\u003eVery cool, I really like the intuitive syntax choice!\u003c/p\u003e\n\u003cp\u003eI don’t think the following is specified: can \u003ccode\u003e.NAME\u003c/code\u003e resolve to an identifier captured earlier in the same pattern?\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003ematch seq:\n    case [x, *_, .x]:  # first and last elements are equal\n        ...    \n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eIf so, it would also raise the question of precedence in case of a conflict.\u003c/p\u003e\n\u003cp\u003ec.f. \u003ca href=\"https://elixir.hexdocs.pm/pattern-matching.html#the-pin-operator\" rel=\"noopener nofollow ugc\"\u003eElixir’s pin (^) operator\u003c/a\u003e is strictly for existing bindings, though it also supports \u003cstrong\u003enon-linear\u003c/strong\u003e matching via repetition.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T02:31:18.638Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":4,"reads":235,"readers_count":234,"score":161.2,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Moncef Slimani","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://elixir.hexdocs.pm/pattern-matching.html#the-pin-operator","internal":false,"reflection":false,"title":"Pattern matching — Elixir v1.20.4","clicks":6}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":6}],"moderator":false,"admin":false,"staff":false,"user_id":93161,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/6","reactions":[{"id":"heart","type":"emoji","count":6}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301965,"name":"Anton Agestam","username":"antonagestam","avatar_template":"/user_avatar/discuss.python.org/antonagestam/{size}/12473_2.png","created_at":"2026-09-18T06:20:33.502Z","cooked":"\u003cp\u003eThis looks like a good solution to this problem. I have had to work around this issue, in one case introducing a wrapping object just so that I could match it with \u003ccode\u003ebox.value\u003c/code\u003e.\u003c/p\u003e\n\u003cp\u003e+1 from me on this idea.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T06:20:33.502Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":214,"readers_count":213,"score":47.2,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Anton Agestam","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":11933,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301971,"name":"Nir Schulman","username":"UltimateLobster","avatar_template":"/user_avatar/discuss.python.org/ultimatelobster/{size}/9727_2.png","created_at":"2026-09-18T08:09:39.397Z","cooked":"\u003cp\u003eI don’t know how intuitive this syntax is for me. It kinda looks like you try to match an object that has an \u003ccode\u003eauthor\u003c/code\u003e attribute. (Like some sort of an inline \u003ccode\u003eProtocol\u003c/code\u003e).\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T08:09:39.397Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":204,"readers_count":203,"score":135.4,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Nir Schulman","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":6}],"moderator":false,"admin":false,"staff":false,"user_id":9448,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-845-leading-dot-value-patterns/109100/8","reactions":[{"id":"heart","type":"emoji","count":6}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":301972,"name":"Marc Mueller","username":"cdce8p","avatar_template":"/user_avatar/discuss.python.org/cdce8p/{size}/3575_2.png","created_at":"2026-09-18T08:52:55.543Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"Mushrimpy\" data-display-name=\"Moncef Slimani\" data-post=\"6\" data-topic=\"109100\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://sea2.discourse-cdn.com/flex002/user_avatar/discuss.python.org/mushrimpy/48/37444_2.png\" class=\"avatar\"\u003e Moncef Slimani:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eI don’t think the following is specified: can \u003ccode\u003e.NAME\u003c/code\u003e resolve to an identifier captured earlier in the same pattern?\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003ematch seq:\n    case [x, *_, .x]:  # first and last elements are equal\n        ...    \n\u003c/code\u003e\u003c/pre\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eThat’s not possible. Name captures are only assigned after the pattern itself matched (but before the guard is evaluated). Therefore your example would raise an error.\u003c/p\u003e\n\u003cpre data-code-wrap=\"py\"\u003e\u003ccode class=\"lang-py\"\u003e\u0026gt;\u0026gt;\u0026gt; match [1, 1]:\n...     case [x, *_, .x]:\n...        pass\n...        \nTraceback (most recent call last):\n  File \"\u0026lt;python-input-8\u0026gt;\", line 2, in \u0026lt;module\u0026gt;\n    case [x, *_, .x]:\n                  ^\nNameError: name 'x' is not defined\n\u003c/code\u003e\u003c/pre\u003e","post_number":9,"post_type":1,"posts_count":11,"updated_at":"2026-09-18T08:52:55.543Z","reply_count":0,"reply_to_post_number":6,"quote_count":1,"incoming_link_count":1,"reads":208,"readers_count":207,"score":76.0,"yours":false,"topic_id":109100,"topic_slug":"pep-845-leading-dot-value-patterns","display_username":"Marc Mueller","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null