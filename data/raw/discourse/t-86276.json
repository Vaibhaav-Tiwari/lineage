003e\u003ccode\u003eplatform.uname().release\u003c/code\u003e returns the version of the Emscripten compiler we compiled with. I can add this.\u003c/p\u003e\n\u003cp\u003eI am not personally interested in wasm64 but I don’t think any of this stuff makes wasm64 any worse off.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":10,"updated_at":"2025-10-28T21:14:30.526Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":109,"readers_count":108,"score":31.8,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Hood Chatham","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":4043,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":275741,"name":"Hood Chatham","username":"hoodmane","avatar_template":"/user_avatar/discuss.python.org/hoodmane/{size}/4037_2.png","created_at":"2025-10-28T21:15:05.571Z","cooked":"\u003cp\u003eThis PEP is informational and doesn’t require any approval process, so I think I can make a PR to mark it as “active”.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":10,"updated_at":"2025-10-28T21:15:05.571Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":107,"readers_count":1