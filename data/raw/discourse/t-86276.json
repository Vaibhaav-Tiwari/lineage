_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":4043,"username":"hoodmane","name":"Hood Chatham","avatar_template":"/user_avatar/discuss.python.org/hoodmane/{size}/4037_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":4}],"moderator":false,"admin":false,"staff":false,"user_id":35,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/6","reactions":[{"id":"heart","type":"emoji","count":4}],"current_user_reaction":null,"reaction_users_count":4,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":275912,"name":"Brett Cannon","username":"brettcannon","avatar_template":"/user_avatar/discuss.python.org/brettcannon/{size}/34895_2.png","created_at":"2025-10-29T22:03:09.882Z","cooked":"\u003cp\u003eCorrect as they are still PEPs.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":10,"updated_at":"2025-10-29T22:03:10.010Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":98,"readers_count":97,"score":19.6,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Brett Cannon","primary_group_name":"committers","flair_name":"packaging-council","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/3X/0/5/05b580b0d5d0ba0258ddcb3685ca7006fcd0f01b.png","flair_bg_color":"","flair_color":"","flair_group_id":48,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Packaging Council Member","title_is_group":false,"reply_to_user":{"id":35,"username":"pf_moore","name":"Paul Moore","avatar_template":"/user_avatar/discuss.python.org/pf_moore/{size}/35_2.png"},"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":36,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":"Automatically removed quote of whole previous post.","can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":288050,"name":"Ramsey","username":"RamseyK","avatar_template":"/user_avatar/discuss.python.org/ramseyk/{size}/28704_2.png","created_at":"2026-03-18T06:59:04.724Z","cooked":"\u003cp\u003esys.implementation._emscripten is probably more inline with other implementations.\u003c/p\u003e\n\u003cp\u003eFor consistency with PEP-783, should sys.platform now return “pyemscripten” ?\u003c/p\u003e\n\u003cp\u003eSounds great on the rest. Thank you for your work on this.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":10,"updated_at":"2026-03-18T07:11:24.882Z","reply_count":1,"reply_to_post_number":4,"quote_count":0,"incoming_link_count":0,"reads":80,"readers_count":79,"score":21.0,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Ramsey","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":4043,"username":"hoodmane","name":"Hood Chatham","avatar_template":"/user_avatar/discuss.python.org/hoodmane/{size}/4037_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":64746,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":288058,"name":"Hood Chatham","username":"hoodmane","avatar_template":"/user_avatar/discuss.python.org/hoodmane/{size}/4037_2.png","created_at":"2026-03-18T10:41:31.905Z","cooked":"\u003cblockquote\u003e\n\u003cp\u003eInstead of sys._emscripten_info, why wouldn’t this be in sys.implementation._emscripten? I see this is already an attribute since 3.11 but could it be moved as it’s marked unstable? This would be consistent with how implementation details are exposed on other platforms like iOS.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eOther people have asked about this too. I don’t care particularly, but it does seem like a nice cleanup. Searching on github there are a decent number of people using it so I’d be cautious about moving it but it does at least have an underscore…\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003eFor consistency with PEP-783, should sys.platform now return “pyemscripten” ?\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eWell on linux \u003ccode\u003esys.platform\u003c/code\u003e returns \u003ccode\u003elinux\u003c/code\u003e not \u003ccode\u003emanylinux\u003c/code\u003e. Changing this would break a lot of code that checks against \u003ccode\u003e“emscripten”\u003c/code\u003e.\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003eFurther any explanation of what would be the result of platform.uname().release?\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eIt’s the emscripten version:\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003e\u0026gt; os.uname()\nposix.uname_result(sysname='Emscripten', nodename='emscripten', release='4.0.9', version='#1', machine='wasm32')\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003ePerhaps I should add this to the PEP text.\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003eAny future consideration for wasm64?\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003ePersonally, I’m not very interested in wasm64. It is substantially slower than wasm32 since for wasm32 each memory gets 4 gb of virtual memory and so no additional work is needed to prevent out of bounds reads/writes. This obviously won’t work with wasm64 since the wasm64 memory space is the same size as the native virtual memory space. The vast majority of web apps can make do with 4 gb of memory (if they need more they can use the file system) and there are no memory management apis so the additional virtual memory space is not usable.\u003c/p\u003e\n\u003cp\u003eOn top of this supporting wasm64 requires a lot of code changes because in wasm64 all pointers are 64 bits and when they pass to JavaScript they become BigInts and adding a BigInt with a Number is a TypeError.\u003c/p\u003e\n\u003cp\u003eThat said, if someone else wanted to drive wasm64 support I would be happy to help out.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":10,"updated_at":"2026-03-18T10:41:31.905Z","reply_count":0,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":0,"reads":76,"readers_count":75,"score":30.2,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Hood Chatham","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":64746,"username":"RamseyK","name":"Ramsey","avatar_template":"/user_avatar/discuss.python.org/ramseyk/{size}/28704_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":4043,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/9","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":289588,"name":"Pablo Galindo Salgado","username":"pablogsal","avatar_template":"/user_avatar/discuss.python.org/pablogsal/{size}/32246_2.png","created_at":"2026-04-04T17:53:37.119Z","cooked":"\u003cp\u003e\u003cimg src=\"https://emoji.discourse-cdn.com/apple/waving_hand.png?v=15\" title=\":waving_hand:\" class=\"emoji only-emoji\" alt=\":waving_hand:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e\u003c/p\u003e\n\u003cp\u003eOn behalf of the Steering Council: while PEP 776 is Informational and doesn’t formally require our approval, we’ve reviewed it and have no objections. The authors asked for an explicit signal from the SC given that the PEP touches CPython directly and implies Tier 3 changes to PEP 11: we’re happy to confirm we’re comfortable with the direction.\u003c/p\u003e\n\u003cp\u003eThanks for excellent work on the PEP, \u003ca class=\"mention\" href=\"/u/hoodmane\"\u003e@hoodmane\u003c/a\u003e and to \u003ca class=\"mention\" href=\"/u/ambv\"\u003e@ambv\u003c/a\u003e for sponsoring.\u003c/p\u003e\n\u003cp\u003eCongrats! \u003cimg src=\"https://emoji.discourse-cdn.com/apple/tada.png?v=15\" title=\":tada:\" class=\"emoji\" alt=\":tada:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":10,"updated_at":"2026-04-04T17:53:37.119Z","reply_count":0,"reply