{"post_stream":{"posts":[{"id":236993,"name":"Hood Chatham","username":"hoodmane","avatar_template":"/user_avatar/discuss.python.org/hoodmane/{size}/4037_2.png","created_at":"2025-03-28T11:18:35.707Z","cooked":"\u003cp\u003eThe discussion the first time was focused on the packaging aspects. \u003ca class=\"mention\" href=\"/u/pf_moore\"\u003e@pf_moore\u003c/a\u003e said that it needed to be separated into its own PEP, so now I’ve removed that. The preview of the updated PEP with only the runtime aspects is \u003ca href=\"https://pep-previews--4327.org.readthedocs.build/pep-0776/\" rel=\"noopener nofollow ugc\"\u003ehere\u003c/a\u003e. I would be interested to receive any feedback on this.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":10,"updated_at":"2025-03-28T15:48:02.757Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":206,"reads":163,"readers_count":162,"score":1107.6,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Hood Chatham","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://pep-previews--4327.org.readthedocs.build/pep-0776/","internal":false,"reflection":false,"title":"PEP 776 – Emscripten Support | peps.python.org","clicks":72}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":4043,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/1","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":256536,"name":"Ramsey","username":"RamseyK","avatar_template":"/user_avatar/discuss.python.org/ramseyk/{size}/28704_2.png","created_at":"2025-06-22T15:23:08.376Z","cooked":"\u003cp\u003eThis looks great!\u003c/p\u003e\n\u003cp\u003eInstead of sys._emscripten_info, why wouldn’t this be in sys.implementation._emscripten? I see this is already an attribute since 3.11 but could it be moved as it’s marked unstable? This would be consistent with how implementation details are exposed on other platforms like iOS.\u003c/p\u003e\n\u003cp\u003eFurther any explanation of what would be the result of platform.uname().release?\u003c/p\u003e\n\u003cp\u003eAny future consideration for wasm64?\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":10,"updated_at":"2025-06-22T16:03:55.990Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":136,"readers_count":135,"score":32.2,"yours":false,"topic_id":86276,"topic_slug":"pep-776-runtime-not-packaging-aspects-of-emscripten-support","display_username":"Ramsey","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":64746,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-776-runtime-not-packaging-aspects-of-emscripten-support/86276/2","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":f