play_username":"Terry Jan Reedy","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":110,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-699-remove-private-dict-version-field-added-in-pep-509/19724/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":69771,"name":"Victor Stinner","username":"vstinner","avatar_template":"/user_avatar/discuss.python.org/vstinner/{size}/15130_2.png","created_at":"2022-10-06T12:10:27.642Z","cooked":"\u003caside class=\"quote group-committers\" data-username=\"tjreedy\" data-post=\"8\" data-topic=\"19724\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://sea2.discourse-cdn.com/flex016/user_avatar/discuss.python.org/tjreedy/48/137_2.png\" class=\"avatar\"\u003e Terry Jan Reedy:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eThe header section needs hard returns so it reads like…\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eClick on “raw” button on GitHub to see newlines \u003cimg src=\"https://emoji.discourse-cdn.com/apple/wink.png?v=12\" title=\":wink:\" class=\"emoji\" alt=\":wink:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":14,"updated_at":"2022-10-06T12:10:27.642Z","reply_count":0,"reply_to_post_number":8,"quote_count":1,"incoming_link_count":2,"reads":134,"readers_count":133,"score":36.8,"yours":false,"topic_id":19724,"topic_slug":"pep-699-remove-private-dict-version-field-added-in-pep-509","display_username":"Victor Stinner","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":13,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-699-remove-private-dict-version-field-added-in-pep-509/19724/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":78164,"name":"Petr Viktorin","username":"encukou","avatar_template":"/user_avatar/discuss.python.org/encukou/{size}/2461_2.png","created_at":"2022-12-15T10:10:39.324Z","cooked":"\u003cp\u003eThe current SC will leave the decision to the next one. However, we see no reason to avoid the usual backwards compatibility policy: the field can be deprecated with a compiler warning, and removed after a minimum of two releases.\u003cbr\u003e\nIf there’s a pressing reason to remove it \u003cem\u003enow\u003c/em\u003e, please put it in the PEP. An extra pointer in all dicts isn’t great, but also not terrible if it’d just be there for the deprecation period.\u003c/p\u003e\n\u003cp\u003e— Petr, on behalf of the SC\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":14,"updated_at":"2022-12-15T10:10:39.324Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":62,"reads":114,"readers_count":113,"score":367.8,"yours":false,"topic_id":19724,"topic_slug":"pep-699-remove-private-dict-version-field-added-in-pep-509","display_username":"Petr Viktorin","primary_group_name":"committers","flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":true,"admin":true,"staff":true,"user_id":26,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-699-remove-private-dict-version-field-added-in-pep-509/19724/10","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":78165,"name":"Petr Viktorin","username":"encukou","avatar_template":"/user_avatar/discuss.python.org/encukou/{size}/2461_2.png","created_at":"2022-12-15T10:12:03.051Z","cooked":"\u003cp\u003eNote that I consider \u003ccode\u003ema_version_tag\u003c/code\u003e part of the \u003cem\u003epublic\u003c/em\u003e C API. These things weren’t as clear back in 2016, but it’s included from \u003ccode\u003e\u0026lt;Python.h\u0026gt;\u003c/code\u003e, not \u003cem\u003edocumented\u003c/em\u003e as private, and according to PEP 509 it’s clearly meant to be used outside CPython.\u003c/p\u003e","post_number":11,"po