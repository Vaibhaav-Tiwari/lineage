ost_number":null,"quote_count":0,"incoming_link_count":1,"reads":220,"readers_count":219,"score":69.0,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Serhiy Storchaka","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":44,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/2","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296643,"name":"Jeremy Hylton","username":"jhylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png","created_at":"2026-07-15T23:26:36.063Z","cooked":"\u003cp\u003eI didn’t see your PEP 837! I thought the process was to take the next available number. How can we fix it?\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":14,"updated_at":"2026-07-15T23:26:36.063Z","reply_count":1,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":1,"reads":217,"readers_count":216,"score":53.4,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Jeremy Hylton","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":44,"username":"storchaka","name":"Serhiy Storchaka","avatar_template":"/user_avatar/discuss.python.org/storchaka/{size}/217_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":168,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/3","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296658,"name":"Hugo van Kemenade","username":"hugovk","avatar_template":"/user_avatar/discuss.python.org/hugovk/{size}/14505_2.png","created_at":"2026-07-16T05:16:33.088Z","cooked":"\u003cp\u003e837-839 are all open PRs. The next available is 840, let’s switch this one to that: \u003ca href=\"https://github.com/python/peps/pull/5043\"\u003epython/peps#5043\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eFor next time, see \u003ca href=\"https://hugovk.dev/next-pep-number/\"\u003ehugovk.dev/next-pep-number/\u003c/a\u003e or:\u003c/p\u003e\n\u003cpre data-code-wrap=\"console\"\u003e\u003ccode class=\"lang-console\"\u003e❯ uvx pepotron next\nNext available PEP: 840\n\u003c/code\u003e\u003c/pre\u003e","post_number":4,"post_type":1,"posts_count":14,"updated_at":"2026-07-16T05:16:33.088Z","reply_count":0,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":2,"reads":207,"readers_count":206,"score":81.4,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Hugo van Kemenade","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://hugovk.dev/next-pep-number/","internal":false,"reflection":false,"title":"Next PEP number","clicks":28},{"url":"https://github.com/python/peps/pull/5043","internal":false,"reflection":false,"title":"PEP 837: Renumber to 840 by hugovk · Pull Request #5043 · python/peps · GitHub","clicks":12}],"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":168,"username":"jhylton","name":"Jeremy Hylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":358,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/4","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296662,"name":"Guido van Rossum","username":"guido","avatar_template":"/user_avatar/discuss.python.org/guido/{size}/21_2.png","created_at":"2026-07-16T07:41:30.855Z","cooked":"\u003cp\u003eLoooking a bit more about the various examples, I think this is the one that’s wrong (and has been since 3.4):\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003ex = 1\ndef f(x):\n    class Test:\n        x = x\n    return Test\nprint(f(2).x)\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eThis prints \u003ccode\u003e1\u003c/code\u003e because for a variable name that the static analysis sees is \u003cem\u003ewritten\u003c/em\u003e in the class, the classic rule “try locals then globals” is used regardless of whether there’s a definition for the name in a containing function scope. But when the name is not assigned locally and there’s a containing function scope that defines the name, the rule “locals, then outer” is used. OTOH when there’s no definition in a containing function scope, the classic rule is also used.\u003c/p\u003e\n\u003cp\u003eMy view is that for the first case (written locally), if there’s a definition in an outer function scope, the “locals, then outer” rule should also be used.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":14,"updated_at":"2026-07-16T07:41:30.855Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":194,"readers_count":193,"score":58.8,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Guido van Rossum","primary_group_name":"committers","flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":10,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/5","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296666,"name":"Jeremy Hylton","username":"jhylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png","created_at":"2026-07-16T09:17:08.809Z","cooked":"\u003caside class=\"quote group-committers\" data-username=\"guido\" data-display-name=\"Guido van Rossum\" data-post=\"5\" data-topic=\"108166\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://sea2.discourse-cdn.com/flex002/user_avatar/discuss.python.org/guido/48/21_2.png\" class=\"avatar\"\u003e Guido van Rossum:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003ex = 1\ndef f(x):\n    class Test:\n        x = x\n    return Test\nprint(f(2).x)\n\u003c/code\u003e\u003c/pre\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eWhat’s the rationale for classes and functions differing in this respect?\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003e\u0026gt;\u0026gt;\u0026gt; x = 0\n\u0026gt;\u0026gt;\u0026gt; def f(x):\n...   def g():\n...     x = x\n...   return g\n... \n\u0026gt;\u0026gt;\u0026gt; f(1)()\nTraceback (most recent call last):\n  File \"\u0026lt;stdin\u0026gt;\", line 1, in \u0026lt;module\u0026gt;\n  File \"\u0026lt;stdin\u0026gt;\", line 3, in g\nUnboundLocalError: local variable 'x' referenced before assignment\n\u0026gt;\u0026gt;\u0026gt; \n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eI feel uncertainty about the two kinds of name resolution working differently. Why should the variable x in “x = x” mean different things on the LHS and RHS?\u003c/p\u003e\n\u003cp\u003eThe best case I can make is backwards compatibility. You could refer to two different variables with “x = x” for so long that it’s too late to change it.\u003c/p\u003e\n\u003cp\u003eJeremy\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":14,"updated_at":"2026-07-16T09:17:08.809Z","reply_count":1,"reply_to_post_number":5,"quote_count":1,"incoming_link_count":1,"reads":185,"readers_count":184,"score":47.0,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Jeremy Hylton","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":168,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296686,"name":"Guido van Rossum","username":"guido","avatar_template":"/user_avatar/discuss.python.org/guido/{size}/21_2.png","created_at":"2026-07-16T12:48:35.219Z","cooked":"\u003cp\u003eName lookup in a class scope is just different. It’s normally dynamically scoped: local first, then fallback (global or containing function). This is different than name lookup in a function — that’s always statically defined (the decision to load a global is statically made based on scope analysis).\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":14,"updated_at":"2026-07-16T12:48:35.219Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":1,"reads":170,"readers_count":169,"score":39.0,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Guido van Rossum","primary_group_name":"committers","flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":168,"username":"jhylton","name":"Jeremy Hylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":10,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296744,"name":"Jelle Zijlstra","username":"Jelle","avatar_template":"/user_avatar/discuss.python.org/jelle/{size}/1049_2.png","created_at":"2026-07-17T02:15:39.277Z","cooked":"\u003cp\u003eI looked into this behavior in some detail when I worked on PEP 695: see my post at \u003ca href=\"https://jellezijlstra.github.io/pep695#class-scopes\" class=\"inline-onebox\"\u003eImplementing PEP 695 | Jelle Zijlstra\u003c/a\u003e and some of the examples in my PyCon talk a few years ago (slides at \u003ca href=\"https://jellezijlstra.github.io/talks/pycon2024-pep695.pdf\"\u003ehttps://jellezijlstra.github.io/talks/pycon2024-pep695.pdf\u003c/a\u003e from slide 34 onward).\u003c/p\u003e\n\u003cp\u003eThe current class scoping behavior is indeed questionable, but the practical impact seems limited and changing a core language behavior is always risky. Therefore, I’d lean towards making no changes and documenting the existing behavior.\u003c/p\u003e\n\u003cp\u003eA useful discussion to look at would be \u003ca href=\"https://discuss.python.org/t/pep-709-one-behavior-change-that-was-missed-in-the-pep/26691\" class=\"inline-onebox\"\u003ePEP 709: one behavior change that was missed in the PEP\u003c/a\u003e, where we discussed another subtle change related to class scopes. There we gathered some evidence from open source code to see how common the affected kind of code was in the wild.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":14,"updated_at":"2026-07-17T02:15:39.277Z","reply_count":2,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":151,"readers_count":150,"score":135.2,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Jelle Zijlstra","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://discuss.python.org/t/pep-709-one-behavior-change-that-was-missed-in-the-pep/26691","internal":true,"reflection":false,"title":"PEP 709: one behavior change that was missed in the PEP","clicks":18},{"url":"https://jellezijlstra.github.io/pep695#class-scopes","internal":false,"reflection":false,"title":"Implementing PEP 695 | Jelle Zijlstra","clicks":7},{"url":"https://jellezijlstra.github.io/talks/pycon2024-pep695.pdf","internal":false,"reflection":false,"clicks":2}],"read":true,"user_title":"CPython core developer","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":6}],"moderator":false,"admin":false,"staff":false,"user_id":9,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/8","reactions":[{"id":"heart","type":"emoji","count":6}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296796,"name":"Jeremy Hylton","username":"jhylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png","created_at":"2026-07-17T13:59:51.700Z","cooked":"\u003cp\u003eI acknowledge that the practical impact is limited and the risks a bit hard to ascertain. I hadn’t seen your talk, but it looks like the PEP recapitulates the point you were making about class namespaces being weird. You make a point that “You never know what’s actually in the class dict” and that seems fundamentally right; it’s hard to do much static analysis of variable use in class namespaces.\u003c/p\u003e\n\u003cp\u003eIt does make sense to analyze a large collection of code to see what the impact might be. I think there are two approximate tests that would be useful. First, look for cases where a straight line analysis shows that a variable is used in a class before binding and also has a binding in an enclosing; these would be cases where we’d expect program behavior to change (but may not). Second, the more general issue is that any local could be deleted unexpectedly, so analyze how often you’re creating a “fallback cell” that isn’t obviously needed but exists in case the local disappears.\u003c/p\u003e\n\u003cp\u003eJeremy\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":14,"updated_at":"2026-07-17T13:59:51.700Z","reply_count":1,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":0,"reads":145,"readers_count":144,"score":34.0,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Jeremy Hylton","primary_group_name":"committers","flair_name":"committers","flair_url":"https://us1.discourse-cdn.com/flex002/uploads/python1/original/1X/ca0883b21b8210c5a62c9ac02353de5f24a4d6fc.png","flair_bg_color":"006b94","flair_color":"fac731","flair_group_id":41,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":9,"username":"Jelle","name":"Jelle Zijlstra","avatar_template":"/user_avatar/discuss.python.org/jelle/{size}/1049_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":168,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296809,"name":"Guido van Rossum","username":"guido","avatar_template":"/user_avatar/discuss.python.org/guido/{size}/21_2.png","created_at":"2026-07-17T16:17:57.775Z","cooked":"\u003cp\u003eI was impressed by the thoroughness of the research done for the class scope issue in PEP 709 (linked by Jelle). But despite that nearly all occurrences found were either false positives or bugs where the proposed new semantics were mistakenly assumed, the old behavior was restored before the PEP was accepted in 3.12.\u003c/p\u003e\n\u003cp\u003eThis suggests that no matter the outcome of similar research we could do for the current proposal, it’s likely that the status quo, inconsistent as it is, will prevail for backward compatibility reasons.\u003c/p\u003e\n\u003cp\u003eTherefore I don’t want to waste more of my time on this discussion.\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":14,"updated_at":"2026-07-17T16:17:57.775Z","reply_count":0,"reply_to_post_number":9,"quote_count":0,"incoming_link_count":1,"reads":139,"readers_count":138,"score":77.8,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Guido van Rossum","primary_group_name":"committers","flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"CPython core developer","title_is_group":true,"reply_to_user":{"id":168,"username":"jhylton","name":"Jeremy Hylton","avatar_template":"/user_avatar/discuss.python.org/jhylton/{size}/5594_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":10,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/10","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":296976,"name":"Howard Lovatt","username":"hlovatt","avatar_template":"/user_avatar/discuss.python.org/hlovatt/{size}/36838_2.png","created_at":"2026-07-20T06:15:48.413Z","cooked":"\u003cp\u003eI would suggest always requiring qualification, like class variables and instance variables, of anything non-local, i.e.:\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003eglobal.x\nnonlocal.x\nnonlocal.nonlocal.x # 2 scopes out\nclass.x # Inside the class itself\nclass.class.x # Inside 2 nested classes themselves\nClassName.x # As is\nClassName0.ClassName1.x # As is\nself.x # As is\nx # Local only\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eSo the example in PEP840 would become:\u003c/p\u003e\n\u003cpre data-code-wrap=\"python\"\u003e\u003ccode class=\"lang-python\"\u003e\u0026gt;\u0026gt;\u0026gt; x = 0\n\u0026gt;\u0026gt;\u0026gt; def f():\n...     x = 1\n...     class A:\n...         x = 2\n...         del class.x\n...         a = global.x\n...     return A\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eUltimately this is a breaking change. However it can be introduced softly over time by staging:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eAllow new qualifications but also allow old syntax.\u003c/li\u003e\n\u003cli\u003eWarn about use of old syntax.\u003c/li\u003e\n\u003cli\u003eError on old syntax.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eWith this process staged over many years.\u003c/p\u003e\n\u003cp\u003eEdit: Corrected a typo and added another existing syntax example.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":14,"updated_at":"2026-07-21T01:29:24.650Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":2,"reads":121,"readers_count":120,"score":34.2,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Howard Lovatt","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":1369,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/11","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":297119,"name":"Joao S. O. Bueno","username":"jsbueno","avatar_template":"/user_avatar/discuss.python.org/jsbueno/{size}/1210_2.png","created_at":"2026-07-21T21:49:18.457Z","cooked":"\u003cblockquote\u003e\n\u003cp\u003eThe current class scoping behavior is indeed questionable, but the practical impact seems limited and changing a core language behavior is always risky.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eWhat if the current behavior is kept, but we could allow either “global” and “nonlocal” keywords  to be used in the class body to disambiguate the behavior when needed, from here forward?\u003c/p\u003e","post_number":12,"post_type":1,"posts_count":14,"updated_at":"2026-07-21T21:49:18.457Z","reply_count":1,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":0,"reads":98,"readers_count":97,"score":24.6,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Joao S. O. Bueno","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":9,"username":"Jelle","name":"Jelle Zijlstra","avatar_template":"/user_avatar/discuss.python.org/jelle/{size}/1049_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":1095,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/12","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":297122,"name":"Carlos","username":"dr_carlos","avatar_template":"/user_avatar/discuss.python.org/dr_carlos/{size}/30461_2.png","created_at":"2026-07-21T23:03:25.465Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"jsbueno\" data-display-name=\"Joao S. O. Bueno\" data-post=\"12\" data-topic=\"108166\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://sea2.discourse-cdn.com/flex002/user_avatar/discuss.python.org/jsbueno/48/1210_2.png\" class=\"avatar\"\u003e Joao S. O. Bueno:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eWhat if the current behavior is kept, but we could allow either “global” and “nonlocal” keywords to be used in the class body to disambiguate the behavior when needed, from here forward?\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eYou already can!\u003c/p\u003e\n\u003cp\u003eI was involved in fixing a few subtle bugs that emerged when \u003ccode\u003eglobal\u003c/code\u003e and \u003ccode\u003enonlocal\u003c/code\u003e are used within a class body when implementing PEPs 649/749.\u003c/p\u003e\n\u003cp\u003eIt certainly highlighted how weird the current behaviour is, but there’s now been so much code written around it, I think it’s too big of a breaking change now.\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":14,"updated_at":"2026-07-21T23:03:25.465Z","reply_count":1,"reply_to_post_number":null,"quote_count":1,"incoming_link_count":0,"reads":97,"readers_count":96,"score":39.4,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Carlos","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":70549,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/13","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":297128,"name":"Joao S. O. Bueno","username":"jsbueno","avatar_template":"/user_avatar/discuss.python.org/jsbueno/{size}/1210_2.png","created_at":"2026-07-22T02:52:58.192Z","cooked":"\u003cblockquote\u003e\n\u003cp\u003eYou already can!\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eOoops - I see your answer, and go try it myself, only to release that (1) yes, one gets a reliable and previsible behavior with both global and nonlocal, and (2) such behavior consists in updating the variable outside the class body scope, and one gets no attribute assignment in the class itself, which is what the PEP is about.  \u003cimg src=\"https://emoji.discourse-cdn.com/apple/slight_smile.png?v=15\" title=\":slight_smile:\" class=\"emoji\" alt=\":slight_smile:\" loading=\"lazy\" width=\"20\" height=\"20\"\u003e\u003c/p\u003e","post_number":14,"post_type":1,"posts_count":14,"updated_at":"2026-07-22T02:52:58.192Z","reply_count":0,"reply_to_post_number":13,"quote_count":0,"incoming_link_count":1,"reads":93,"readers_count":92,"score":23.6,"yours":false,"topic_id":108166,"topic_slug":"pep-840-name-resolution-in-class-namespaces","display_username":"Joao S. O. Bueno","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":70549,"username":"dr_carlos","name":"Carlos","avatar_template":"/user_avatar/discuss.python.org/dr_carlos/{size}/30461_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":1095,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/pep-840-name-resolution-in-class-namespaces/108166/14","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[296638,296642,296643,296658,296662,296666,296686,296744,296796,296809,296976,297119,297122,297128]},"timeline_lookup":[[1,91],[7,90],[9,89],[11,87],[12,85]],"suggested_topics":[],"tags":[],"tags_descriptions":{},"fancy_title":"PEP 840: Name Resolution in Class Namespaces","id":108166,"title":"PEP 840: Name Resolution in Class Namespaces","posts_count":14,"created_at":"2026-07-15T23:17:04.574Z","views":1157,"reply_count":8,"like_count":16,"last_posted_at":"2026-07-22T02:52:58.192Z","visible":true,"closed":false,"archived":false,"has_summary":true,"archetype":"regular","slug":"pep-840-name-resolution-in-class-namespaces","category_id":19,"word_count":1281,"deleted_at":null,"user_id":168,"featured_link":null,"pinned_globally":false,"pinned_at":null,"pinned_until":null,"image_url":null,"slow_mode_seconds":0,"draft":null,"draft_key":"topic_108166","draft_sequence":null,"unpinned":null,"pinned":false,"current_post_number":1,"highest_post_number":14,"deleted_by":null,"actions_summary":[{"id":4,"count":0,"hidden":false,"can_act":false},{"id":8,"count":0,"hidden":false,"can_act":false},{"id":10,"count":0,"hidden":false,"can_