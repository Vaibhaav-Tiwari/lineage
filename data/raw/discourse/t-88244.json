8ddcb3685ca7006fcd0f01b.png","flair_color":"","flair_bg_color":"","flair_group_id":48,"admin":true,"moderator":true,"trust_level":4}],"created_by":{"id":447,"username":"Zac-HD","name":"Zac Hatfield-Dodds","avatar_template":"/user_avatar/discuss.python.org/zac-hd/{size}/607_2.png"},"last_poster":{"id":2481,"username":"iritkatriel","name":"Irit Katriel","avatar_template":"/user_avatar/discuss.python.org/iritkatriel/{size}/2615_2.png"},"links":[{"url":"https://peps.python.org/pep-0785/","title":"PEP 785 – New methods for easier handling of ExceptionGroups | peps.python.org","internal":false,"attachment":false,"reflection":false,"clicks":62,"user_id":447,"domain":"peps.python.org","root_domain":"python.org"},{"url":"https://docs.python.org/3/library/exceptions.html#ExceptionGroup","title":"Built-in Exceptions — Python 3.13.3 documentation","internal":false,"attachment":false,"reflection":false,"clicks":10,"user_id":447,"domain":"docs.python.org","root_domain":"python.org"},{"url":"https://peps.python.org/pep-0654/","title":"PEP 654 – Exception Groups and except* | peps.python.org","internal":false,"attachment":false,"reflection":false,"clicks":8,"user_id":447,"domain":"peps.python.org","root_domain":"python.org"},{"url":"https://peps.python.org/pep-0654/#handling-exception-groups","title":"PEP 654 – Exception Groups and except* | peps.python.org","internal":false,"attachment":false,"reflection":false,"clicks":2,"user_id":2481,"domain":"peps.python.org","root_domain":"python.org"}]},"bookmarks":[]}