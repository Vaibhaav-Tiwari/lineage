ping.rst`](https://github.com/python/cpython/blob/main/Doc/library/typing.rst)\n\n<!-- gh-issue-number: gh-137840 -->\n* Issue: gh-137840\n<!-- /gh-issue-number -->\n","reactions":{"url":"https://api.github.com/repos/python/cpython/issues/137933/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":2,"eyes":0},"timeline_url":"https://api.github.com/repos/python/cpython/issues/137933/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}