id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f4e51f253ad6c27583438f6182c33cf368bfa45f","url":"https://api.github.com/repos/python/cpython/commits/f4e51f253ad6c27583438f6182c33cf368bfa45f","html_url":"https://github.com/python/cpython/commit/f4e51f253ad6c27583438f6182c33cf368bfa45f"}]},{"sha":"f4e51f253ad6c27583438f6182c33cf368bfa45f","node_id":"C_kwDOBN0Z8doAKGY0ZTUxZjI1M2FkNmMyNzU4MzQzOGY2MTgyYzMzY2YzNjhiZmE0NWY","commit":{"author":{"name":"Barney Gale","email":"barney.gale@gmail.com","date":"2025-10-17T21:57:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2025-10-17T21:57:51Z"},"message":"GH-133789: Fix unpickling of pathlib objects pickled in Python 3.13 (#133831)\n\nIn Python 3.13 (but not 3.12 or 3.14), pathlib classes are defined in\n`pathlib._local` rather than `pathlib`. In hindsight this was a mistake,\nbut it was difficult to predict how the abstract/local split would pan out.\n\nIn this patch we re-introduce `pathlib._local` as a stub module that\nre-exports the classes from `pathlib`. This allows path objects pickled in\n3.13 to be unpicked in 3.14+","tree":{"sha":"4728c099f4248b669f5aa6d94e3482ffe2a0968e","url":"https://api.github.com/repos/python/cpython/git/trees/4728c099f4248b669f5aa6d94e3482ffe2a0968e"},"url":"https://api.github.com/repos/python/cpython/git/commits/f4e51f253ad6c27583438f6182c33cf368bfa45f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJo8rvfCRC1aQ7uu5UhlAAA3scQAFfXwQJXYCHPrD+dT/8BvGgZ\nzDYI5CGAnAw9MwLsGac4jAxbtiYgd4Odvw9yIDCTC2mWFGPDv5H2X+7i2hpVi6re\n8Wd3jI2aqFy1Qv1LMRWtJsnkPpkLtuHdBHsS/YPjagDvFwEe14ZmwzNQn+WHN4gk\nsQvT10FKNRHioSxN0lo0t0mMsOjsFO45IiMPSn1/fWN8gJLgN2VPGec4Enn61aaG\nJVoBTffvaMh2c0D2fjccuLjqdDrsm6mz3GG8r7zllkJhXUOCAuRVC7IMqTliCpcp\nepIC3cHwNZwHck7TdyM2a/uWNaWjV4rnh5Tz70Yndbg0tnASheCyD9X4dDweEsVz\ny0r7WD+IyaAJ9S9tSt22gdRIlqCwms05775Sav+E32Y0sqAVQCZvgOumyOvGXCw3\nF3TesySCwpV+Jo224E+6cCpZEY5vc0C2WbAUqi7WNqQuO5VoPpVEI41qzj9jqk2B\nODs3CfXJT5lYLrOP/nSeiVfEfPB1VFtXJCxbxQd/de7WMm9T5GfzjBtX8obHZoeX\nffxNiGd20bWmOlhHvwVtCTzQOzBM++G0mfgGhzYu9bN3a7hr2vGjP6MU9CYdsdJC\nHAb3Cln4wctorGBrRwDO7F6jUVUcdBCjSbjw0LzbQAafvltQnJslDKP1HdNCO7fC\ntnUWP/7bdk9kRhITelwg\n=1XOP\n-----END PGP SIGNATURE-----\n","payload":"tree 4728c099f4248b669f5aa6d94e3482ffe2a0968e\nparent 92025ea2c8a10aa0e3dd5a2a1548f9bb17fe7dbc\nauthor Barney Gale <barney.gale@gmail.com> 1760738271 +0100\ncommitter GitHub <noreply@github.com> 1760738271 +0000\n\nGH-133789: Fix unpickling of pathlib objects pickled in Python 3.13 (#133831)\n\nIn Python 3.13 (but not 3.12 or 3.14), pathlib classes are defined in\n`pathlib._local` rather than `pathlib`. In hindsight this was a mistake,\nbut it was difficult to predict how the abstract/local split would pan out.\n\nIn this patch we re-introduce `pathlib._local` as a stub module that\nre-exports the classes from `pathlib`. This allows path objects pickled in\n3.13 to be unpicked in 3.14+","verified_at":"2025-10-17T21:57:51Z"}},"url":"https://api.github.com/repos/python/cpython/commits/f4e51f253ad6c27583438f6182c33cf368bfa45f","html_url":"https://github.com/python/cpython/commit/f4e51f253ad6c27583438f6182c33cf368bfa45f","comments_url":"https://api