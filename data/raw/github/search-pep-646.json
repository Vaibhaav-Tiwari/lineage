://github.com/python/cpython/pull/101254","diff_url":"https://github.com/python/cpython/pull/101254.diff","patch_url":"https://github.com/python/cpython/pull/101254.patch","merged_at":"2023-01-23T08:20:16Z"},"body":"(cherry picked from commit 807d6b576fa37f3ab7eb951297cb365c0c198595)\n\nCo-authored-by: Nikita Sobolev <mail@sobolevn.me>\n\n<!-- gh-issue-number: gh-101015 -->\n* Issue: gh-101015\n<!-- /gh-issue-number -->\n","reactions":{"url":"https://api.github.com/repos/python/cpython/issues/101254/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/cpython/issues/101254/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/python/cpython/issues/31018","repository_url":"https://api.github.com/repos/python/cpython","labels_url":"https://api.github.com/repos/python/cpython/issues/31018/labels{/name}","comments_url":"https://api.github.com/repos/python/cpython/issues/31018/comments","events_url":"https://api.github.com/repos/python/cpython/issues/31018/events","html_url":"https://github.com/python/cpython/pull/31018","id":1118512305,"node_id":"PR_kwDOBN0Z8c4xymv4","number":31018,"title":"bpo-43224: Implement PEP 646 grammar changes","user":{"login":"mrahtz","id":4431336,"node_id":"MDQ6VXNlcjQ0MzEzMzY=","avatar_url":"https://avatars.githubusercontent.com/u/4431336?v=4","gravatar_id":"","url":"https://api.github.com/users/mrahtz","html_url":"https://github.com/mrahtz","followers_url":"https://api.github.com/users/mrahtz/followers","following_url":"https://api.github.com/users/mrahtz/following{/other_user}","gists_url":"https://api.github.com/users/mrahtz/gists{/gist_id}","starred_url":"https://api.github.com/users/mrahtz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrahtz/subscriptions","organizations_url":"https://api.github.com/users/mrahtz/orgs","repos_url":"https://api.github.com/users/mrahtz/repos","events_url":"https://api.github.com/users/mrahtz/events{/privacy}","received_events_url":"https://api.github.com/users/mrahtz/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":24,"created_at":"2022-01-30T12:04:29Z","updated_at":"2022-05-19T14:24:14Z","closed_at":"2022-03-26T16:55:36Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/python/cpython/pulls/31018","html_url":"https://github.com/python/cpython/pull/31018","diff_url":"https://github.com/python/cpython/pull/31018.diff","patch_url":"https://github.com/python/cpython/pull/31018.patch","merged_at":"2022-03-26T16:55:36Z"},"body":"These are the parts of the old PR (https://github.com/python/cpython/pull/30398) relevant to only the grammar changes. To summarise, this adds support for:\r\n\r\n1. Starring within squared brackets, e.g. `Tensor[*Ts]`, `Tensor[T, *Ts]` (where `Ts` is a `TypeVarTuple` and `T` is a `TypeVar`).\r\n    * But _not_ within an actual slice - e.g. `Tensor[0:*Ts]` should _not_ be valid.\r\n2. Starring the annotation given to `*args`, e.g. `*args: *Ts`.\r\n\r\nFor 1, our intention is to call `__iter__` on `Ts` and add the items from the resulting iterator to the tuple of arguments sent to `Tensor.__cls_getitem__`. For example, with `Tensor[*Ts]`, if `Ts.__iter__` returns an iterator yielding `Ts.unpacked`, `Tensor.__cls_getitem__` would receive `(Ts.unpacked,)`. With `Tensor[T, *Ts]`, `Tensor.__cls_getitem__` would receive `(T, Ts.unpacked)`.\r\n\r\nFor 2, our intention is to call `__iter__` on `Ts`, get a single item from the iterator, verify that the iterator is exhausted, and set that item as the annotation for `*args`.\r\n\r\nI'm guessing the person I should ask for review on this is @pablogsal?\n\n<!-- issue-number: [bpo-43224](https://bugs.python.org/issue43224) -->\nhttps://bugs.python.org/issue43224\n<!-- /issue-number -->\n","reactions":{"url":"https://api.github.com/repos/python/cpython/issues/31018/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/python/cpython/issues/31018/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/python/cpython/issues/31021","repository_url":"https://api.github.com/repos/python/cpython","labels_url":"https://api.github.com/repos/python/cpython/issues/31021/labels{/name}","comments_url":"https://api.github.com/repos/python/cpython/issues/31021/comments","events_url":"https://api.github.com/repos/python/cpython/issues/31021/events","html_url":"https://github.com/python/cpython/pull/31021","id":1118541090,"node_id":"PR_kwDOBN0Z8c4xyshW","number":31021,"title":"bpo-43224: Implement PEP 646 changes to typing.py","user":{"login":"mrahtz","id":4431336,"node_id":"MDQ6VXNlcjQ0MzEzMzY=","avatar_url":"https://avatars.githubusercontent.com/u/4431336?v=4","gravatar_id":"","url":"https://api.github.com/users/mrahtz","html_url":"https://github.com/mrahtz","followers_url":"https://api.github.com/users/mrahtz/followers","following_url":"https://api.github.com/users/mrahtz/following{/other_user}","gists_url":"https://api.github.com/users/mrahtz/gists{/gist_id}","starred_url":"https://api.github.com/users/mrahtz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mrahtz/subscriptions","organizations_url":"https://api.github.com/users/mrahtz/orgs","repos_url":"https://api.github.com/users/mrahtz/repos","events_url":"https://api.github.com/users/mrahtz/events{/privacy}","received_events_url":"https://api.github.com/users/mrahtz/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[{"login":"JelleZijlstra","id":90